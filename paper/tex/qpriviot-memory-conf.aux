\newlabel{tab:lira-sweep}{{IV}{6}{}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces \textbf  {(a) Private utility} under the three projections (topic-acc @ $\varepsilon \approx 9.3$, real \texttt  {all-MiniLM-L6-v2}, $N = 100$, $K = 32$; higher is better). Tiny-$d$ wins \emph  {only} under the leaky data-dependent PCA.}}{6}{}\protected@file@percent }
\newlabel{tab:abl-utility}{{V}{6}{}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces \textbf  {(b) Leakage} under the three projections (tail-AUC at $K = 1024$; $0.5 =$ no leakage). The pre-DP gradient that motivated the crossover claim exists only under data-PCA; post-DP every cell is at chance.}}{6}{}\protected@file@percent }
\newlabel{tab:abl-leakage}{{VI}{6}{}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces \textbf  {Calibrated} LiRA on the LLM-distilled payload (500 users, 6{,}116 notes, $K = 32$, $d = 32$; 3 seeds $\times $ 48 shadows): the realistic agent-memory object, measured with the attack \S  \ref {sec:proxy-blind} shows to be the only trustworthy one. The raw-turn row is Table~\ref {tab:frontier}'s $K = 32$ row, repeated for comparison at the \emph  {same} operating point.}}{6}{}\protected@file@percent }
\newlabel{tab:distilled-lira}{{VII}{6}{}{table.7}{}}
